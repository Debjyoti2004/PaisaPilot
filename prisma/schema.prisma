generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth models ───────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]

  // User's data
  budgetPeriods      BudgetPeriod[]
  transactions       Transaction[]
  savingsBuckets     SavingsBucket[]
  goals              Goal[]
  splitConfigs       SplitConfig[]
  notifications      Notification[]
  suggestions        Suggestion[]
  settings           AppSettings?
  wealthPlan         WealthPlan?
  recurringPayments  RecurringPayment[]
  dismissedPatterns  DismissedPattern[]
  userBudgets        UserBudget[]
  userTags           UserTag[]
  categoryRules      CategoryRule[]
  familyMemberships  FamilyMember[]
  quickNotes         QuickNote[]
  userSubcategories  UserSubcategory[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App models (all scoped to userId) ────────────────────────────────────

model Category {
  id           String        @id @default(uuid())
  name         String
  kind         String
  icon         String
  color        String
  parentId     String?
  parent       Category?     @relation("SubCategories", fields: [parentId], references: [id])
  children     Category[]    @relation("SubCategories")
  transactions Transaction[]
  envelopes    Envelope[]
  splitRules   SplitRule[]
  suggestions  Suggestion[]
  createdAt    DateTime      @default(now())

  @@unique([name])
}

model SplitConfig {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  active        Boolean        @default(false)
  version       Int            @default(1)
  activeFrom    DateTime?
  activeUntil   DateTime?
  rules         SplitRule[]
  adjustRule    AdjustRule?
  budgetPeriods BudgetPeriod[]
  createdAt     DateTime       @default(now())
}

model SplitRule {
  id         String      @id @default(uuid())
  configId   String
  config     SplitConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category    @relation(fields: [categoryId], references: [id])
  mode       String
  value      Float
  priority   Int         @default(0)
  minFloor   Float?
  maxCap     Float?
  flexRank   Int         @default(5)
}

model AdjustRule {
  id             String      @id @default(uuid())
  configId       String      @unique
  config         SplitConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  surplusSplit   Json
  shortfallOrder Json
}

model BudgetPeriod {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  configId       String
  config         SplitConfig @relation(fields: [configId], references: [id])
  month          DateTime
  incomeTotal    Float       @default(0)
  expectedIncome Float       @default(37000)
  status         String      @default("active")
  envelopes      Envelope[]
  createdAt      DateTime    @default(now())
}

model Envelope {
  id           String        @id @default(uuid())
  periodId     String
  period       BudgetPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id])
  allocated    Float
  spent        Float         @default(0)
  rollover     Boolean       @default(false)
  transactions Transaction[]
}

model Transaction {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelopeId  String?
  envelope    Envelope? @relation(fields: [envelopeId], references: [id])
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  amount      Float
  type        String
  source      String    @default("manual")
  narration   String
  merchantKey String?
  note        String?
  dedupeHash  String?   @unique
  occurredAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  // Ledgerly-style fields (new)
  merchant       String?
  account        String?   @default("Main Checking")
  tags           String    @default("[]")
  wealthGroup    String?
  actualPaidDate DateTime? // actual payment date when occurredAt is shifted to month-1st
}

model SavingsBucket {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  liquidity String
  balance   Float         @default(0)
  icon      String        @default("💰")
  color     String        @default("#10b981")
  entries   BucketEntry[]
  createdAt DateTime      @default(now())
}

model BucketEntry {
  id        String        @id @default(uuid())
  bucketId  String
  bucket    SavingsBucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  amount    Float
  month     DateTime
  note      String?
  createdAt DateTime      @default(now())
}

model Goal {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  icon          String    @default("🎯")
  color         String    @default("#6366f1")
  targetAmount  Float
  savedAmount   Float     @default(0)
  deadline      DateTime?
  monthlyNeeded Float?
  status        String    @default("active")
  createdAt     DateTime  @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Suggestion {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  kind        String
  payload     Json
  status      String    @default("pending")
  snoozeUntil DateTime?
  createdAt   DateTime  @default(now())
}

model AppSettings {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expectedSalary Float   @default(37000)
  savingsFloor   Float   @default(3000)
  currency       String  @default("INR")
  salaryKeywords String  @default("salary,credit,sal")
  emailReports   Boolean @default(false)
  reportEmail    String  @default("")

  // Net worth (Ledgerly)
  assetsTotal        Float   @default(0)
  liabilitiesTotal   Float   @default(0)
  netWorthConfigured Boolean @default(false)
  selectedPeriod     String  @default("all-time")

  // Drive sync
  driveFolder        String?
  driveFolderId      String?
  driveLastSync      DateTime?
  driveResetAt       DateTime?
  driveEnabled       Boolean @default(false)

  // Salary carryover: treat income on day 25-31 of prev month as this month
  salaryCarryover    Boolean @default(false)

  // PIN lock
  pinEnabled      Boolean   @default(false)
  pinHash         String?
  pinOtp          String?
  pinOtpExpiry    DateTime?
  pinPromptSeen   Boolean   @default(false)

  // Dashboard widgets: JSON array of account names to show as cards
  dashboardWidgets String  @default("[]")
  // Custom accounts: JSON array of { name, type } added by user
  customAccounts   String  @default("[]")
}

// Wealth Plan (Warikoo model) — per user, stored in DB
model WealthPlan {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startingSalary        Float    @default(25000)
  startingAge           Int      @default(21)
  incrementRate         Float    @default(0.10)
  inflationRate         Float    @default(0.06)
  extraMonthlyInvest    Float    @default(0)
  bracket               Int      @default(1)
  updatedAt             DateTime @updatedAt
  overrides             WealthPlanOverride[]
}

// Per-month investment override (user adds extra on top of formula)
model WealthPlanOverride {
  id            String     @id @default(uuid())
  planId        String
  plan          WealthPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  month         String     // YYYY-MM
  instrument    String     // e.g. "stocks", "mutual_funds", "epf", "nps", "gold"
  extraAmount   Float
  note          String?
  createdAt     DateTime   @default(now())

  @@unique([planId, month, instrument])
}

// Recurring payments (confirmed)
model RecurringPayment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  String   @default("Other")
  amount    Float
  cadence   String   // weekly | biweekly | monthly | quarterly | annual
  nextDate  String   // YYYY-MM-DD
  account   String?
  active    Boolean  @default(true)
  isSubType Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Dismissed recurring pattern keys
model DismissedPattern {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patternKey String
  createdAt DateTime @default(now())

  @@unique([userId, patternKey])
}

// User budget (Ledgerly-style, per category, monthly limit)
model UserBudget {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   String
  monthlyLimit Float
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([userId, category])
}

// Tags (global tag registry)
model UserTag {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

// Categorization rules
model CategoryRule {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  whenText   String
  thenText   String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// ─── Family sharing ────────────────────────────────────────────────────────

model Family {
  id        String         @id @default(cuid())
  name      String
  members   FamilyMember[]
  invites   FamilyInvite[]
  createdAt DateTime       @default(now())
}

model FamilyMember {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // "owner" | "viewer"
  createdAt DateTime @default(now())

  @@unique([familyId, userId])
}

model FamilyInvite {
  id          String    @id @default(cuid())
  familyId    String
  family      Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  label       String?
  email       String?   // email the invite was sent to
  token       String    @unique @default(cuid())
  otp         String?   // 6-digit OTP code
  otpExpiry   DateTime? // OTP expires at this time (5 min from creation)
  otpUsed     Boolean   @default(false)
  otpAttempts Int       @default(0)
  accepted    Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}

model UserSubcategory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  wealthGroup String  // 'needs' | 'wants' | 'investments'
  createdAt  DateTime @default(now())

  @@unique([userId, name])
}

model QuickNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("")
  content   String   @db.Text @default("")
  color     String   @default("#ffffff")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
